# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- LLM (Google Gemini) ---------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- MLflow ----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_MODEL_NAME=cancer-risk-classifier

# --- Airflow 3 REST API (credentials of a restricted local user) ------------
AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=agent
AIRFLOW_PASSWORD=
AIRFLOW_APPROVED_DAGS=ml_training_pipeline

# --- Kubernetes ------------------------------------------------------------
# Restricted kubeconfig generated by scripts/make_agent_kubeconfig.sh (namespace-scoped RBAC)
AGENT_KUBECONFIG=./agent.kubeconfig
K8S_NAMESPACE=mlops-agent
K8S_APPROVED_NAMESPACES=mlops-agent

# --- Agent behaviour / retraining policy -----------------------------------
TOOL_TIMEOUT_SECONDS=45
RETRAIN_MAX_MODEL_AGE_DAYS=30
RETRAIN_MIN_F1=0.93
